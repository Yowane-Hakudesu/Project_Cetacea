<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下的备份规则：同样什么都不备份。 -->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="database"
        path="." />
</full-backup-content>
