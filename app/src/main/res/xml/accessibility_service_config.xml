<?xml version="1.0" encoding="utf-8"?>
<!--
  无障碍服务配置。
  注意：
  1) canPerformGestures 打开后才能用 dispatchGesture 注入点击/滑动；
  2) canRetrieveWindowContent 打开后才能拿 getRootInActiveWindow() 的节点树；
  3) canTakeScreenshot（API 30+）用于可选的视觉模型输入，老系统会忽略该属性；
  4) flagRetrieveInteractiveWindows 让服务能访问多窗口，便于判断当前前台应用。
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewLongClicked|typeViewScrolled|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows|flagIncludeNotImportantViews"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="150"
    android:settingsActivity="com.whalechan.agent.ui.MainActivity"
    android:summary="@string/accessibility_service_summary" />
