<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">鲸鱼娘</string>

    <!-- 无障碍服务：这段文字会原样显示在系统授权页，必须诚实描述用途 -->
    <string name="accessibility_service_description">鲸鱼娘需要无障碍权限来替你操作屏幕：读取当前界面的按钮、文字与输入框位置，并按你的指令执行点击、滑动、输入。所有操作都在本机完成，不会上传屏幕内容；只有你主动发起任务时，才会把被裁剪过的界面摘要（文字与控件位置，不含密码框内容）发送给你自己配置的 LLM 端点。</string>
    <string name="accessibility_service_summary">让鲸鱼娘看见界面并代你点击、滑动、输入</string>

    <!-- 通知渠道 -->
    <string name="channel_keepalive">常驻运行</string>
    <string name="channel_keepalive_desc">鲸鱼娘在后台待命时显示的低优先级通知</string>
    <string name="channel_task">任务进度</string>
    <string name="channel_task_desc">执行任务时的步骤提示</string>
    <string name="channel_confirm">敏感操作确认</string>
    <string name="channel_confirm_desc">涉及付款、设置、删除、发消息时的确认请求</string>

    <!-- 常驻通知 -->
    <string name="notif_keepalive_title">鲸鱼娘 · 待命中</string>
    <string name="notif_keepalive_idle">鲸鱼娘在后台趴着，随时听你吩咐 🐋</string>
    <string name="notif_action_chat">说话</string>
    <string name="notif_action_stop">停止</string>
    <string name="notif_action_stop_task">停任务</string>
    <string name="notif_running">正在执行：%1$s（第 %2$d/%3$d 步）</string>
    <string name="notif_running_unlimited">正在执行：%1$s（第 %2$d 步 · 无限模式）</string>
    <string name="notif_paused">已暂停在第 %1$d 步，等你决定「继续 / 放弃」</string>

    <!-- 步数上限暂停 -->
    <string name="pause_title">鲸鱼娘想继续做，要吗？</string>
    <string name="pause_text">已经执行 %1$d 步，到步数上限了。点「继续」再加一轮预算；10 分钟内不回应按放弃处理。</string>
    <string name="pause_continue">继续</string>
    <string name="pause_abort">放弃</string>

    <!-- 确认 -->
    <string name="confirm_title">鲸鱼娘想先问你一句</string>
    <string name="confirm_approve">确认执行</string>
    <string name="confirm_deny">不要</string>

    <!-- 后台启动受限时的提示 -->
    <string name="launch_needed_title">需要你点一下</string>
    <string name="launch_needed_text">系统不允许鲸鱼娘在后台直接打开「%1$s」。点这条通知就能让她继续。</string>
</resources>
